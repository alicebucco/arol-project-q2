# Copy to .env and replace local secrets before starting Docker.
POSTGRES_USER=arol
POSTGRES_PASSWORD=choose_a_local_password
POSTGRES_DB=arol
POSTGRES_HOST=db
POSTGRES_PORT=5432

LLM_BASE_URL=https://api.inceptionlabs.ai/v1
LLM_API_KEY=replace_with_your_mercury_key
LLM_MODEL=mercury-2
LLM_PLANNER_ENABLED=false

# Local authentication. Keep both values only in .env, never commit them.
AUTH_JWT_SECRET="your_hash_key"
AUTH_JWT_EXPIRE_MINUTES=60
# Used once by db/scripts/set_development_passwords.py for synthetic users.
AUTH_DEVELOPMENT_PASSWORD= password
